---
// Three gold threads that start far apart and slowly braid together down the page.
// threads.js draws them as the visitor scrolls and adds sparkles at the needle tips.
const W = 1440;
const H = 7000;
const Y0 = 900;
const Y1 = H - 250;
const N = 700;

const center = (s) => [W / 2 + 380 * Math.sin(Math.PI * 2 * 1.6 * s + 0.6), Y0 + (Y1 - Y0) * s];

function thread(i) {
  const pts = [];
  for (let k = 0; k <= N; k++) {
    const s = k / N;
    const [x, y] = center(s);
    const [xa, ya] = center(Math.max(0, s - 0.001));
    const [xb, yb] = center(Math.min(1, s + 0.001));
    const len = Math.hypot(xb - xa, yb - ya) || 1;
    const nx = -(yb - ya) / len;
    const ny = (xb - xa) / len;
    // Wide and loose at the top, tight and fast-twisting near the bottom.
    const spread = 34 + 330 * Math.pow(1 - s, 1.6);
    const twist = Math.PI * 2 * (2.5 * s + 5.5 * s * s) + (i * Math.PI * 2) / 3;
    const off = spread * Math.sin(twist);
    const px = Math.min(W - 10, Math.max(10, x + nx * off));
    pts.push(`${px.toFixed(1)} ${(y + ny * off).toFixed(1)}`);
  }
  return `M${pts.join('L')}`;
}

const lines = [0, 1, 2].map((i) => ({ d: thread(i), width: [1.3, 1, 0.8][i] }));
---
<div class="threads" aria-hidden="true">
 <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
  <defs>
   <linearGradient id="thread-gold" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#9C7A3E"/>
    <stop offset=".3" stop-color="#F6E3B4"/>
    <stop offset=".55" stop-color="#C9A46A"/>
    <stop offset=".8" stop-color="#F2DDA8"/>
    <stop offset="1" stop-color="#9C7A3E"/>
   </linearGradient>
   <radialGradient id="tip-glow">
    <stop offset="0" stop-color="#FFF4D6" stop-opacity=".95"/>
    <stop offset=".3" stop-color="#F2DDA8" stop-opacity=".45"/>
    <stop offset="1" stop-color="#C9A46A" stop-opacity="0"/>
   </radialGradient>
  </defs>
  <g class="base">{lines.map((l) => <path d={l.d} stroke-width={l.width * 0.7} />)}</g>
  <g class="halo">{lines.map((l) => <path d={l.d} stroke-width="7" pathLength="1" />)}</g>
  <g class="ink">{lines.map((l) => <path class="draw" d={l.d} stroke-width={l.width} pathLength="1" />)}</g>
  {lines.map(() => (
   <g class="tip">
    <circle class="tip-halo" r="26" fill="url(#tip-glow)" />
    <circle r="2.4" fill="#FFF8E6" />
   </g>
  ))}
 </svg>
 <canvas class="sparks"></canvas>
</div>
