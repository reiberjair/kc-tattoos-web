---
// Three gold threads that start far apart, braid together down the page and then
// part ways, each curling into its own resting point where the needle tip keeps glowing.
// threads.js draws them as the visitor scrolls and adds sparkles at the tips.
const W = 1440;
const H = 7000;
const Y0 = 900;
const Y1 = 5300;
const N = 800;

// Where each thread comes to rest: both edges after "Specialties", and below "Process".
const ends = [
  { x: 90, y: 4600, turn: 1 },
  { x: 1266, y: 4640, turn: -1 },
  { x: 477, y: 5200, turn: 1 },
];

const center = (s) => [W / 2 + 380 * Math.sin(Math.PI * 2 * 1.6 * s + 0.6), Y0 + (Y1 - Y0) * s];
const smooth = (a, b, v) => {
  const k = Math.min(1, Math.max(0, (v - a) / (b - a)));
  return k * k * (3 - 2 * k);
};

function braid(s, i) {
  const [x, y] = center(s);
  const [xa, ya] = center(Math.max(0, s - 0.001));
  const [xb, yb] = center(Math.min(1, s + 0.001));
  const len = Math.hypot(xb - xa, yb - ya) || 1;
  const spread = 34 + 330 * Math.pow(1 - s, 1.6);
  const twist = Math.PI * 2 * (2.5 * s + 5.5 * s * s) + (i * Math.PI * 2) / 3;
  const off = spread * Math.sin(twist);
  return [x - ((yb - ya) / len) * off, y + ((xb - xa) / len) * off];
}

function thread(i) {
  const end = ends[i];
  const pts = [];
  for (let k = 0; k <= N; k++) {
    const s = k / N;
    let [x, y] = braid(Math.min(s, 0.8), i);
    if (s > 0.8) {
      // Leave the braid and spiral into the resting point.
      const u = (s - 0.8) / 0.2;
      const r = 150 * (1 - u);
      const a = end.turn * (Math.PI * 3.2 * u) + i * 2.1;
      const sx = end.x + r * Math.cos(a);
      const sy = end.y + r * Math.sin(a);
      const w = smooth(0, 0.45, u);
      x = x * (1 - w) + sx * w;
      y = y * (1 - w) + sy * w;
    }
    pts.push(`${Math.min(W - 10, Math.max(10, x)).toFixed(1)} ${y.toFixed(1)}`);
  }
  return `M${pts.join('L')}`;
}

const lines = [0, 1, 2].map((i) => ({ d: thread(i), width: [1.3, 1.05, 0.85][i] }));
---
<div class="threads" aria-hidden="true">
 <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
  <defs>
   <linearGradient id="thread-gold" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#9C7A3E"/>
    <stop offset=".3" stop-color="#F6E3B4"/>
    <stop offset=".55" stop-color="#C9A46A"/>
    <stop offset=".8" stop-color="#F2DDA8"/>
    <stop offset="1" stop-color="#9C7A3E"/>
   </linearGradient>
  </defs>
  {/* Static version for phones: a soft glow under a thin core. */}
  <g class="base">
   {lines.map((l) => <path class="glow" d={l.d} stroke-width="5" />)}
   {lines.map((l) => <path d={l.d} stroke-width={l.width * 0.7} />)}
  </g>
  {/* Live version: two halo layers make the drawn line look softly incandescent. */}
  <g class="halo halo-wide">{lines.map((l, i) => <path class="ink-part" data-i={i} d={l.d} stroke-width="12" />)}</g>
  <g class="halo halo-near">{lines.map((l, i) => <path class="ink-part" data-i={i} d={l.d} stroke-width="3.6" />)}</g>
  <g class="ink">{lines.map((l, i) => <path class="draw ink-part" data-i={i} d={l.d} stroke-width={l.width} />)}</g>
 </svg>
 <canvas class="sparks"></canvas>
</div>
