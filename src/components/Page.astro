---
import '../styles/global.css';
import Threads from './Threads.astro';
import { languages, text } from '../i18n.js';

const { lang } = Astro.props;
const t = text[lang];
const f = t.form;
const other = lang === 'es' ? 'en' : 'es';
const site = 'https://kctattoos-demo.netlify.app';
const icon = { fill: 'none', stroke: '#C9A46A', 'stroke-width': '1.4', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true' };
const formMessages = {
  'data-one': f.one, 'data-many': f.many, 'data-sending': f.sending,
  'data-ok-title': f.okTitle, 'data-ok-text': f.okText, 'data-error': f.error,
};
---
<!doctype html>
<html lang={languages[lang].htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{t.title}</title>
<meta name="description" content={t.description}>
<meta name="theme-color" content="#0B0B0C">
<link rel="alternate" hreflang="es" href={`${site}/`}>
<link rel="alternate" hreflang="en" href={`${site}/en/`}>
<link rel="alternate" hreflang="x-default" href={`${site}/`}>
<meta property="og:title" content={t.title}>
<meta property="og:description" content={t.description}>
<meta property="og:type" content="website">
<meta property="og:image" content="/img/hero/hero-1920.webp">
{/* Follow the visitor's saved choice, otherwise the browser language (Spanish only for es-*). */}
<script is:inline define:vars={{ lang }}>
document.documentElement.classList.add('js');
try {
  var saved = localStorage.getItem('kc-lang');
  var browser = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
  var wanted = saved || (browser.indexOf('es') === 0 ? 'es' : 'en');
  if (wanted !== lang) location.replace((wanted === 'en' ? '/en/' : '/') + location.hash);
} catch (e) {}
</script>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
<Threads />
<section class="hero" id="inicio">
 <picture>
  <source media="(max-width:900px)" srcset="/img/hero/hero-movil.webp">
  <img fetchpriority="high" width="1672" height="941" src="/img/hero/hero-1920.webp" alt={t.heroAlt}>
 </picture>
 <div class="shade"></div><div class="frame"></div>
 <header class="top">
  <a href="#inicio" class="logo">
   <svg width="38" height="38" viewBox="0 0 32 32" fill="none" stroke="#C9A46A" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g transform="rotate(-45 16 16)"><path d="M1 16h4 M5 16l4-2.6v5.2z M9 13h8v6H9z M18.5 12.6v6.8 M19.5 12.4h9v7.2h-9z M28.5 16c2 0 2.5-2 2.5-3.5"/></g><circle cx="4.2" cy="28" r="1.4" fill="#E8CF9A" stroke="none"/></svg>
   <span class="ink-write" style="--d:.3s;--t:1.6s"><span class="ink-text gold">KC Tattoos</span><i class="ink-tip"></i></span>
  </a>
  <nav class="links">
   <a href="#obra">{t.nav.work}</a><a href="#proceso">{t.nav.process}</a><a href="#karla">{t.nav.karla}</a><a href="#preguntas">{t.nav.faq}</a>
   <a class="lang" href={languages[other].path} hreflang={other} lang={other} title={t.switchTo} data-lang={other}>{languages[other].label}</a>
   <a class="btn line" href="#contacto">{t.nav.contact}</a>
  </nav>
 </header>
 <div class="hero-body"><div>
  <span class="eyebrow">{t.eyebrow}</span>
  <h1>
   <span class="ln"><span class="ink-write" style="--d:.8s;--t:1.1s"><span class="ink-text">{t.h1[0]}</span><i class="ink-tip"></i></span></span>
   <span class="ln"><span class="ink-write" style="--d:1.8s;--t:1.3s"><em class="ink-text gold">{t.h1[1]}</em><i class="ink-tip"></i></span></span>
   <span class="ln"><span class="ink-write" style="--d:2.9s;--t:.9s"><span class="ink-text">{t.h1[2]}</span><i class="ink-tip"></i></span></span>
  </h1>
  <p>{t.heroP}</p>
  <div class="cta"><a class="btn solid" href="#contacto">{t.ctaIdea}</a><a class="btn line" href="#obra" style="border-color:transparent;padding:0">{t.ctaWork}</a></div>
 </div></div>
 <div class="hero-meta"><span>{t.heroMeta}</span></div>
 <a class="scroll" href="#karla" aria-label={t.scrollLabel}><span class="mouse"><i></i></span>{t.scroll}</a>
</section>

<section class="story" id="karla">
 <div class="story-photo">
  <div class="arch" aria-hidden="true"><div class="arch-core"></div></div>
  <div class="story-floor" aria-hidden="true"></div>
  <div class="portrait">
   <img loading="lazy" width="900" height="1350" src="/img/karla/karla.webp" srcset="/img/karla/karla-560.webp 560w, /img/karla/karla.webp 900w" sizes="(max-width:900px) 90vw, 45vw" alt={t.portraitAlt}>
  </div>
 </div>
 <div class="story-text">
  <article class="panel">
   <span class="eyebrow">{t.hello}</span>
   <p class="quote" set:html={t.quote} />
   <span class="sign">Karla Chirinos<small>{t.signRole}</small></span>
  </article>
  <article class="panel">
   <span class="eyebrow">{t.artist}</span>
   <h2 class="gold">Karla Chirinos</h2>
   <p class="role">{t.role}</p>
   {t.bio.map((p) => <p>{p}</p>)}
   <ul class="facts">{t.facts.map(([k, v]) => <li><b>{k}</b><span>{v}</span></li>)}</ul>
  </article>
  <article class="panel">
   <span class="eyebrow">{t.howEyebrow}</span>
   <h2 set:html={t.howTitle} />
   <div class="frame2"><div class="ph"><img loading="lazy" src="/img/hero/estudio-manos-1000.webp" alt={t.handsAlt}></div></div>
   <p>{t.howP}</p>
   <div><a class="btn solid" href="#contacto">{t.ctaIdea}</a></div>
  </article>
 </div>
</section>
<div class="wrap">
 <div class="trust">
  <div><svg width="22" height="22" viewBox="0 0 24 24" {...icon}><path d="M4 20l10-10M12 8l4 4M15 5l4 4-3 3-4-4z"/></svg>{t.trust[0]}</div>
  <div><svg width="22" height="22" viewBox="0 0 24 24" {...icon}><path d="M12 3c3 4 6 7 6 11a6 6 0 0 1-12 0c0-4 3-7 6-11z"/></svg>{t.trust[1]}</div>
  <div><svg width="22" height="22" viewBox="0 0 24 24" {...icon}><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4"/></svg>{t.trust[2]}</div>
  <div><svg width="22" height="22" viewBox="0 0 24 24" {...icon}><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg>{t.trust[3]}</div>
 </div>
</div>

<section class="obra" id="obra">
 <div class="wrap">
  <div class="head"><div><span class="eyebrow">{t.portfolio}</span><h2 class="gold">{t.workTitle}</h2></div><small>{t.demoNote}</small></div>
  <div class="grid">
   {t.work.map(([img, title, meta, alt]) => (
    <figure><div class="ph"><img loading="lazy" src={`/img/tatuajes/${img}.webp`} alt={alt}></div><figcaption><b>{title}</b><span>{meta}</span></figcaption></figure>
   ))}
  </div>
  <div class="more"><a class="btn line" href="#">{t.moreIg}</a></div>
 </div>
</section>

<section class="esp">
 <div class="wrap">
  <div><span class="eyebrow">{t.specEyebrow}</span><h2 style="margin-top:18px" set:html={t.specTitle} /></div>
  <ul>{t.specs.map(([h, p], i) => <li><span>{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>)}</ul>
 </div>
</section>

<section class="proc" id="proceso">
 <div class="wrap">
  <div style="text-align:center"><span class="eyebrow">{t.procEyebrow}</span><h2 class="gold" style="margin-top:18px">{t.procTitle}</h2></div>
  <div class="steps">{t.steps.map(([h, p], i) => <div><b class="gold">{['I', 'II', 'III'][i]}</b><h3>{h}</h3><p>{p}</p></div>)}</div>
 </div>
</section>

<section class="contact" id="contacto">
 <div class="wrap">
  <div>
   <span class="eyebrow">{t.contactEyebrow}</span>
   <h2 class="gold">{t.contactTitle}</h2>
   <p class="lead">{t.contactLead}</p>
   <ul class="chan">
    <li><svg width="22" height="22" viewBox="0 0 24 24" {...icon}><path d="M21 12a9 9 0 0 1-13.5 7.8L3 21l1.3-4.3A9 9 0 1 1 21 12z"/></svg><div><small>WhatsApp</small><span>[+1 000 000 0000]</span></div></li>
    <li><svg width="22" height="22" viewBox="0 0 24 24" {...icon}><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="#C9A46A"/></svg><div><small>Instagram</small><span>@[usuario]</span></div></li>
    <li><svg width="22" height="22" viewBox="0 0 24 24" {...icon}><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><div><small>Email</small><span>[correo@dominio.com]</span></div></li>
    <li><svg width="22" height="22" viewBox="0 0 24 24" {...icon}><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><div><small>{t.studio}</small><span>{t.address}</span></div></li>
   </ul>
  </div>
  <form id="contact-form" name="contacto" method="POST" action={f.action} data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data" {...formMessages}>
   <input type="hidden" name="form-name" value="contacto">
   <input type="hidden" name="idioma" value={lang}>
   <p hidden><label>{f.honeypot} <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
   <h3>{f.title}</h3>
   <p class="sub">{f.required}</p>
   <div class="row">
    <label>{f.name}<input type="text" name="nombre" required autocomplete="name" placeholder={f.namePh}></label>
    <label>{f.contact}<input type="text" name="contacto" required autocomplete="email" placeholder={f.contactPh}></label>
   </div>
   <div class="row">
    <label>{f.zone}<select name="zona"><option value="">{f.zonePh}</option>{f.zones.map((z) => <option>{z}</option>)}</select></label>
    <label>{f.size}<select name="tamano"><option value="">{f.sizePh}</option>{f.sizes.map((s) => <option>{s}</option>)}</select></label>
   </div>
   <label>{f.idea}<textarea name="idea" required placeholder={f.ideaPh}></textarea></label>
   <label>{f.photos}
    <span class="drop"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C9A46A" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V5M7.5 9.5L12 5l4.5 4.5M4 16v3h16v-3"/></svg><span><b id="drop-title">{f.dropTitle}</b><span id="drop-hint">{f.dropHint}</span></span><input type="file" id="photos" accept="image/*" multiple></span>
   </label>
   <button class="btn solid" type="submit" id="send">{f.send}</button>
   <p class="note" id="status" role="status" aria-live="polite">{f.note}</p>
  </form>
 </div>
</section>

<section class="faq" id="preguntas">
 <div class="wrap">
  <div style="text-align:center;margin-bottom:60px"><span class="eyebrow">{t.faqEyebrow}</span><h2 class="gold" style="margin-top:18px">{t.faqTitle}</h2></div>
  {t.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
 </div>
</section>

<footer>
 <div class="wrap">
  <span class="big gold">KC Tattoos</span>
  <div class="foot"><span>{t.footer}</span><nav><a href="#">Instagram</a><a href="#">WhatsApp</a><a href="#">Email</a></nav></div>
 </div>
</footer>
<script src="../scripts/form.js"></script>
<script src="../scripts/threads.js"></script>
<script src="../scripts/lang.js"></script>
<script src="../scripts/reveal.js"></script>
</body>
</html>
