---
import '../styles/global.css';
import { languages, text } from '../i18n.js';

const { lang } = Astro.props;
const t = text[lang].thanks;
---
<!doctype html>
<html lang={languages[lang].htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>{t.title} · KC Tattoos</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
<main class="wrap" style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:22px">
 <span class="eyebrow">KC Tattoos</span>
 <h1 class="gold" style="font-size:clamp(48px,8vw,96px)">{t.title}</h1>
 <p style="color:var(--soft);max-width:460px;margin:0">{t.text}</p>
 <a class="btn line" href={languages[lang].path}>{t.back}</a>
</main>
</body>
</html>
